# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================
# Este archivo SÍ se sube a GitHub.
# Copiar a .env.local y rellenar con credenciales reales.
#
# IMPORTANTE: Nunca pegar credenciales reales aquí.
# Las credenciales reales van en:
#   - .env.local (local / Codespaces, NO se sube)
#   - Vercel > Settings > Environment Variables (producción y preview)
#
# En React (CRA), las variables deben empezar con REACT_APP_
# para que estén disponibles en el bundle del cliente.
# ============================================

# ---- Entorno actual ----
# Valores válidos: "production" | "development"
REACT_APP_ENV=development

# ---- Supabase ----
# Producción (docxentra-prod)
REACT_APP_SUPABASE_URL_PROD=https://TU-PROYECTO-PROD.supabase.co
REACT_APP_SUPABASE_ANON_KEY_PROD=TU_ANON_KEY_PROD

# Desarrollo (docxentra-dev)
REACT_APP_SUPABASE_URL_DEV=https://TU-PROYECTO-DEV.supabase.co
REACT_APP_SUPABASE_ANON_KEY_DEV=TU_ANON_KEY_DEV

# ---- Selección activa (la que usará el código) ----
# En Vercel > Production: usar PROD
# En Vercel > Preview:    usar DEV
# En local / Codespaces:  usar DEV
REACT_APP_SUPABASE_URL=${REACT_APP_SUPABASE_URL_DEV}
REACT_APP_SUPABASE_ANON_KEY=${REACT_APP_SUPABASE_ANON_KEY_DEV}